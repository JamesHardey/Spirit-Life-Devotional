# ── Admin ────────────────────────────────────────────────────────────────────
# Password that gates the /admin dashboard. Change this before deploying.
ADMIN_PASSWORD=changeme

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate a keypair with:  npm run generate-vapid
# Then paste the values below. The public key is also exposed to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address embedded in push requests (mailto: or https:)
VAPID_SUBJECT=mailto:adefehintijames007@gmail.com

# ── Supabase ─────────────────────────────────────────────────────────────────
# When these are set, the app stores devotionals + push subscriptions in
# Supabase Postgres instead of the local /data JSON files.
# Project Settings → API:
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # service_role secret — SERVER ONLY, never exposed to the browser
# Project Settings → Database → Connection string (URI) — used by `npm run migrate`:
SUPABASE_DB_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-REF.supabase.co:5432/postgres
